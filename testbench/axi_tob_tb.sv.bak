`timescale 1ns/1ps

module axi_top_tb ;

    // parameters matching the DUT
    localparam ADDR_WIDTH = 32 ;
    localparam DATA_WIDTH = 32 ;
    localparam FIFO_DEPTH = 16 ;
    localparam MEM_DEPTH  = 256 ;

    // clock / reset
    logic aclk    ;
    logic aresetn ;

    // write side
    logic                    start_wr      ;
    logic [ADDR_WIDTH-1:0]   wr_addr       ;
    logic [7:0]               wr_len        ;
    logic [1:0]               wr_burst      ;
    logic [2:0]               wr_size       ;
    logic                     wr_push       ;
    logic [DATA_WIDTH-1:0]   wr_push_data  ;
    logic                     wr_fifo_full  ;
    logic                     tx_done       ;
    logic [1:0]               tx_resp       ;

    // read side
    logic                    start_rd      ;
    logic [ADDR_WIDTH-1:0]   rd_addr       ;
    logic [7:0]               rd_len        ;
    logic [1:0]               rd_burst      ;
    logic [2:0]               rd_size       ;
    logic                     rd_pop        ;
    logic [DATA_WIDTH-1:0]   rd_pop_data   ;
    logic                     rd_fifo_empty ;
    logic                     rx_done       ;

    integer errors     ;
    integer test_count ;


    // -------------------------------------------------------------------------
    // DUT instantiation
    // -------------------------------------------------------------------------
    axi_top #(
        .ADDR_WIDTH(ADDR_WIDTH), .DATA_WIDTH(DATA_WIDTH),
        .FIFO_DEPTH(FIFO_DEPTH), .MEM_DEPTH(MEM_DEPTH)
    ) dut (
        .aclk(aclk),
        .aresetn(aresetn),
        .start_wr(start_wr),
        .wr_addr(wr_addr),
        .wr_len(wr_len),
        .wr_burst(wr_burst),
        .wr_size(wr_size),
        .wr_push(wr_push),
        .wr_push_data(wr_push_data),
        .wr_fifo_full(wr_fifo_full),
        .tx_done(tx_done),
        .tx_resp(tx_resp),
        .start_rd(start_rd),
        .rd_addr(rd_addr),
        .rd_len(rd_len),
        .rd_burst(rd_burst),
        .rd_size(rd_size),
        .rd_pop(rd_pop),
        .rd_pop_data(rd_pop_data),
        .rd_fifo_empty(rd_fifo_empty),
        .rx_done(rx_done)
    );


    // -------------------------------------------------------------------------
    // Clock generation - 10ns period (100 MHz)
    // -------------------------------------------------------------------------
    initial aclk = 1'b0 ;
    always #5 aclk = ~aclk ;


    // -------------------------------------------------------------------------
    // Reset task
    // -------------------------------------------------------------------------
    task do_reset ;
        begin
            aresetn = 1'b0 ;

            start_wr     = 1'b0 ;
            wr_addr      = {ADDR_WIDTH{1'b0}} ;
            wr_len       = 8'b0 ;
            wr_burst     = 2'b0 ;
            wr_size      = 3'b0 ;
            wr_push      = 1'b0 ;
            wr_push_data = {DATA_WIDTH{1'b0}} ;

            start_rd = 1'b0 ;
            rd_addr  = {ADDR_WIDTH{1'b0}} ;
            rd_len   = 8'b0 ;
            rd_burst = 2'b0 ;
            rd_size  = 3'b0 ;
            rd_pop   = 1'b0 ;

            errors = 0 ;

            repeat (5) @(posedge aclk) ;
            aresetn = 1'b1 ;
            @(posedge aclk) ;
        end
    endtask


    // -------------------------------------------------------------------------
    // Mask a data word down to only the byte lanes valid for a given size,
    // starting at byte offset 0 (used to trim the expected value for narrow
    // transfers, since untouched bytes in memory stay at their reset value)
    // -------------------------------------------------------------------------
    function automatic [DATA_WIDTH-1:0] mask_narrow (
        input [2:0]              size ,
        input [DATA_WIDTH-1:0]  data
    ) ;
        integer size_bytes ;
        integer i ;
        logic [DATA_WIDTH-1:0] masked ;
        begin
            case (size)
                3'b000:  size_bytes = 1 ;
                3'b001:  size_bytes = 2 ;
                default: size_bytes = DATA_WIDTH/8 ;
            endcase

            masked = {DATA_WIDTH{1'b0}} ;
            for (i = 0; i < DATA_WIDTH/8; i = i + 1) begin
                if (i < size_bytes)
                    masked[i*8 +: 8] = data[i*8 +: 8] ;
            end

            mask_narrow = masked ;
        end
    endfunction


    task automatic do_write (
        input [ADDR_WIDTH-1:0] addr       ,
        input [7:0]             len        ,
        input [1:0]              burst      ,
        input [2:0]              size       ,
        input [DATA_WIDTH-1:0]  data_seed  ,
        input                   increment              // 1 = data_seed+k per beat, 0 = same data_seed every beat
    ) ;
        integer k ;
        logic [DATA_WIDTH-1:0] beat_data ;
        begin
            for (k = 0; k <= len; k = k + 1) begin
                @(posedge aclk) ;
                beat_data    = increment ? (data_seed + k) : data_seed ;
                wr_push      = 1'b1 ;
                wr_push_data = beat_data ;
            end
            @(posedge aclk) ;
            wr_push = 1'b0 ;

            wr_addr  = addr  ;
            wr_len   = len   ;
            wr_burst = burst ;
            wr_size  = size  ;
            start_wr = 1'b1  ;
            @(posedge aclk) ;
            start_wr = 1'b0  ;

            wait (tx_done == 1'b1) ;
            @(posedge aclk) ;

            if (tx_resp !== 2'b00)
                $display("[%0t] ERROR: write response not OKAY, got %0b", $time, tx_resp) ;
            else
                $display("[%0t] Write transaction complete, resp = OKAY", $time) ;
        end
    endtask


    task automatic do_read (
        input [ADDR_WIDTH-1:0] addr       ,
        input [7:0]             len        ,
        input [1:0]              burst      ,
        input [2:0]              size       ,
        input [DATA_WIDTH-1:0]  data_seed  ,
        input                   increment
    ) ;
        integer k ;
        logic [DATA_WIDTH-1:0] beat_data ;
        logic [DATA_WIDTH-1:0] expected ;
        begin
            rd_addr  = addr  ;
            rd_len   = len   ;
            rd_burst = burst ;
            rd_size  = size  ;
            start_rd = 1'b1  ;
            @(posedge aclk) ;
            start_rd = 1'b0  ;

            wait (rx_done == 1'b1) ;
            @(posedge aclk) ;

            for (k = 0; k <= len; k = k + 1) begin
                @(posedge aclk) ;
                rd_pop = 1'b1 ;
                @(posedge aclk) ;
                rd_pop = 1'b0 ;

                beat_data = increment ? (data_seed + k) : data_seed ;
                expected  = beat_data ;                                // no masking - memory writes the full word regardless of WSTRB

                if (rd_pop_data !== expected) begin
                    $display("[%0t] ERROR: beat %0d mismatch - expected %h, got %h",
                              $time, k, expected, rd_pop_data) ;
                    errors = errors + 1 ;
                end
                else begin
                    $display("[%0t] beat %0d OK - data = %h", $time, k, rd_pop_data) ;
                end
            end
        end
    endtask

    task run_test (
        input [127:0]            test_name  ,
        input [ADDR_WIDTH-1:0]  addr        ,
        input [7:0]               len         ,
        input [1:0]                burst       ,
        input [2:0]                size        ,
        input [DATA_WIDTH-1:0]    data_seed   ,
        input                       increment
    ) ;
        integer errors_before ;
        begin
            test_count    = test_count + 1 ;
            errors_before = errors ;

            $display("\n=== TEST %0d: %0s ===", test_count, test_name) ;
            $display("addr=%h len=%0d burst=%0b size=%0b", addr, len, burst, size) ;

            do_write ( addr , len , burst , size , data_seed , increment ) ;
            do_read  ( addr , len , burst , size , data_seed , increment ) ;

            if (errors == errors_before)
                $display("--- TEST %0d PASSED ---", test_count) ;
            else
                $display("--- TEST %0d FAILED (%0d new errors) ---", test_count, errors - errors_before) ;
        end
    endtask

    // -------------------------------------------------------------------------
    // VCD Dump Generation
    // -------------------------------------------------------------------------
    initial begin
        $dumpfile("axi_top_tb.vcd"); // Specifies the name of the output VCD file
        $dumpvars(0, axi_top_tb);     // Dumps all signals in axi_top_tb and child modules
    end

    // -------------------------------------------------------------------------
    // Main test sequence
    // -------------------------------------------------------------------------
    initial begin
        errors     = 0 ;
        test_count = 0 ;

        do_reset ;

        run_test ( "4-beat INCR write/read at addr 0" ,
            32'h0000_0000 , 8'd3 , 2'b01 , 3'b010 , 32'hA0A0_0000 , 1'b1 ) ;

        run_test ( "single-beat INCR write/read at addr 0x40" ,
            32'h0000_0040 , 8'd0 , 2'b01 , 3'b010 , 32'hDEAD_0000  , 1'b1 ) ;

        run_test ( "8-beat INCR write/read at addr 0x100" ,
            32'h0000_0100 , 8'd7 , 2'b01 , 3'b010 , 32'hCAFE_0000  , 1'b1 ) ;

        run_test ( "4-beat WRAP write/read at addr 0x200" ,
            32'h0000_0200 , 8'd3 , 2'b10 , 3'b010 , 32'hBEEF_0000  , 1'b1 ) ;

        run_test ( "8-beat WRAP write/read at addr 0x318 (mid-boundary start)" ,
            32'h0000_0318 , 8'd7 , 2'b10 , 3'b010 , 32'hFACE_0000  , 1'b1 ) ;

        run_test ( "2-beat WRAP write/read at addr 0x500" ,
            32'h0000_0500 , 8'd1 , 2'b10 , 3'b010 , 32'h2222_0000 , 1'b1  ) ;

        run_test ( "16-beat WRAP write/read at addr 0x608 (mid-boundary start)" ,
            32'h0000_0608 , 8'd15 , 2'b10 , 3'b010 , 32'h3333_0000 , 1'b1  ) ;

        run_test ( "4-beat INCR write/read near upper address bound" ,
            32'h0000_FFE0 , 8'd3 , 2'b01 , 3'b010 , 32'h4444_0000  , 1'b1 ) ;

        run_test ( "single-beat WRAP write/read at addr 0x700" ,
            32'h0000_0700 , 8'd0 , 2'b10 , 3'b010 , 32'h5555_0000  , 1'b1 ) ;

        run_test ( "4-beat narrow (2-byte) INCR write/read at addr 0xA00" ,
            32'h0000_0A00 , 8'd3 , 2'b01 , 3'b001 , 32'h8888_0000  , 1'b0 ) ;

        run_test ( "4-beat narrow (1-byte) INCR write/read at addr 0xB00" ,
            32'h0000_0B00 , 8'd3 , 2'b01 , 3'b000 , 32'h9999_0000,  1'b0   ) ;

        repeat (10) @(posedge aclk) ;

        $display("\n=====================================") ;
        if (errors == 0)
            $display("=== ALL %0d TESTS PASSED ===", test_count) ;
        else
            $display("=== TESTS FAILED: %0d total errors across %0d tests ===", errors, test_count) ;
        $display("=====================================") ;

        $stop ;
    end

endmodule